# ignore Python cache files
*__pycache__
.pytest_cache/
# ignore VSCode settings and workspace files
.vscode/
# ignore codex files and settings
.codex
# ignore claude files and settings
.claude

# ignore heavy data files (including the local datasets/, splits/, feature_svd/,
# induced_subgraphs/ and filters/ symlinks) but keep the dataset lists and the
# .gitkeep file for directory structure
data/*
!data/.gitkeep
!data/*.tsv
# regenerated by data preparation (data_preparation.summary_file)
data/summary.tsv

# ignore outputs but keep .gitkeep files for directory structure
outputs/*
!outputs/.gitkeep

# ignore logs but keep .gitkeep files for directory structure
# (lives under the wholesale-ignored outputs/, so re-include the tree first)
!outputs/logs/
outputs/logs/*
!outputs/logs/.gitkeep

# ignore trained model checkpoints but keep .gitkeep files for directory structure
!outputs/trained_models/
outputs/trained_models/*
!outputs/trained_models/.gitkeep

# ignore pretrained model checkpoints but keep .gitkeep files for directory structure
!outputs/pretrained_models/
outputs/pretrained_models/*
!outputs/pretrained_models/.gitkeep

# ignore finetuned model checkpoints but keep .gitkeep files for directory structure
!outputs/finetuned_models/
outputs/finetuned_models/*
!outputs/finetuned_models/.gitkeep

# ignore result tables but keep .gitkeep files for directory structure
!outputs/results/
outputs/results/*
!outputs/results/.gitkeep

# ignore analysis study outputs but keep .gitkeep files for directory structure
!outputs/analysis/
outputs/analysis/*
!outputs/analysis/.gitkeep

# ignore slurm outputs but keep .gitkeep files for directory structure
slurm/output/*
!slurm/output/.gitkeep

*.lock
